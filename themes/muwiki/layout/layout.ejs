<!-- layout/layout.ejs -->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title><%= page.title ? page.title + ' | ' : '' %><%= config.title || 'Blog' %></title>
    <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
    <% if (page.path === 'about/index.html' || page.layout === 'about') { %>
        <link rel="stylesheet" href="<%= url_for('/css/about.css') %>">
    <% } %>
</head>
<body>
    <div class="watermark-bg"></div>

    <% 
        // --- 核心逻辑 ---
        // 修改点：全部由 let 改为 var，确保在后面的 HTML 中可以读取到这些变量
        var pageType = 'Blog'; 
        var headerText = 'Blog';
        var showRightSidebar = false; // 默认
        var sidebarState = 'collapsed'; 
        var sidebarCfg = theme.sidebar || {};

        // 1. 获取 source 路径
        var currentSource = (page.source || '').replace(/\\/g, '/');

        // 2. 页面类型判断
        if (is_home()) {
            pageType = 'Home';
            headerText = config.title; // 首页显示站点标题
            sidebarState = 'expanded';
            showRightSidebar = true; // 首页现在需要右侧栏
        } 
        else if (page.path.startsWith('about/') || page.layout === 'about') {
            pageType = 'About';
            headerText = 'About';
            sidebarState = 'expanded';
            showRightSidebar = true; // About页现在需要右侧栏
        } 
        else if (page.list_type) { // Blog/Note 列表页
            if (page.list_type === 'note') {
                pageType = 'Note';
                headerText = 'Note';
            } else {
                pageType = 'Blog';
                headerText = 'Blog';
            }
            showRightSidebar = true; // 列表页开启右侧栏
        }
        else if (is_post()) { // 文章详情页
            showRightSidebar = true; 
            if (currentSource.indexOf('_posts/note/') > -1) {
                pageType = 'Note';
                headerText = 'Note';
            } else {
                pageType = 'Blog';
                headerText = 'Blog';
            }
        }
    %>

    <div class="layout-container <%= showRightSidebar ? 'has-right-sidebar' : '' %>">
        
        <!-- === 1. 左侧区域 === -->
        <div class="left-column">
            <aside class="sidebar-card user-card <%= sidebarState %>" id="userSidebar">
                <div class="card-toggle-btn" id="sidebarToggle" title="Toggle Info">
                    <span class="toggle-arrow"></span>
                </div>
                <div class="sidebar-inner">
                    <div class="author-area">
                        <img class="avatar" src="<%= url_for(sidebarCfg.avatar || '/images/avatar.svg') %>" alt="avatar">
                        <h3 class="author-name"><%= sidebarCfg.name || config.author %></h3>
                        <p class="author-desc"><%= sidebarCfg.description %></p>
                    </div>
                    <nav class="sidebar-nav">
                        <% if (sidebarCfg.links && sidebarCfg.links.length){ %>
                            <% sidebarCfg.links.forEach(function(link){ %>
                                <%
                                    var navText = (link.text || '').toLowerCase();
                                    var navTarget = '';
                                    if (navText === 'home') navTarget = 'Home';
                                    else if (navText === 'blog') navTarget = 'Blog';
                                    else if (navText === 'note') navTarget = 'Note';
                                    else if (navText === 'about') navTarget = 'About';
                                    var navActive = navTarget && navTarget === pageType;
                                %>
                                <a href="<%= link.url %>" class="nav-link <%= navActive ? 'active' : '' %>"><%= link.text %></a>
                            <% }) %>
                        <% } %>
                    </nav>
                </div>
            </aside>

            <!-- 左下侧边栏：Blog/Note 模式下显示目录/最近文章 -->
            <% if (pageType === 'Blog' || pageType === 'Note') { %>
                <aside class="sidebar-card extra-card">
                    <div class="extra-inner">
                        <% if (pageType === 'Blog') { %>
                            <h4 class="extra-title">Recent Blogs</h4>
                            <ul class="extra-list">
                                <% 
                                    var blogPosts = site.posts.filter(p => p.source.replace(/\\/g, '/').indexOf('_posts/blog/') > -1);
                                    blogPosts.sort('date', -1).limit(5).each(function(post){ 
                                %>
                                    <li><a href="<%= url_for(post.path) %>"><span class="list-title"><%= post.title %></span><span class="list-date"><%= date(post.date, 'MM.DD') %></span></a></li>
                                <% }) %>
                            </ul>
                        <% } else if (pageType === 'Note') { %>
                            <h4 class="extra-title">Directory</h4>
                            <div class="category-tree">
                                <% 
                                    // === 核心逻辑：根据文件路径构建目录树 ===
                                    
                                    // 1. 获取所有 Note 文章
                                    var notePosts = site.posts.filter(function(post){
                                        return post.source.replace(/\\/g, '/').indexOf('_posts/note/') > -1;
                                    }).toArray();

                                    // 2. 构建树形结构对象的函数
                                    function buildTree(posts) {
                                        var tree = { _files: [] };
                                        posts.forEach(function(post) {
                                            // 获取相对路径：_posts/note/Java/基础.md -> Java/基础.md
                                            var src = post.source.replace(/\\/g, '/');
                                            var prefix = '_posts/note/';
                                            var idx = src.indexOf(prefix);
                                            if (idx === -1) return;
                                            
                                            var relPath = src.substring(idx + prefix.length);
                                            var parts = relPath.split('/');
                                            
                                            var current = tree;
                                            
                                            // 遍历路径部分
                                            for(var i=0; i < parts.length; i++) {
                                                var part = parts[i];
                                                if (i === parts.length - 1) {
                                                    // 是文件 (.md)
                                                    if(!current._files) current._files = [];
                                                    current._files.push(post);
                                                } else {
                                                    // 是文件夹
                                                    if (!current[part]) current[part] = { _files: [] };
                                                    current = current[part];
                                                }
                                            }
                                        });
                                        return tree;
                                    }

                                    // 3. 递归渲染 HTML 的函数
                                    function renderTree(node, depth) {
                                        var html = '';
                                        var keys = Object.keys(node).sort(); // 文件夹按字母排序
                                        
                                        // 先遍历文件夹
                                        keys.forEach(function(key) {
                                            if (key === '_files') return; // 跳过文件数组，稍后处理
                                            
                                            html += '<ul class="note-ul depth-' + depth + '">';
                                            html += '<li class="note-folder">';
                                            html += '<span class="folder-label">' + key + '</span>';
                                            html += renderTree(node[key], depth + 1); // 递归
                                            html += '</li>';
                                            html += '</ul>';
                                        });

                                        // 再遍历当前层级的文件
                                        if (node._files && node._files.length > 0) {
                                            html += '<ul class="note-ul depth-' + depth + '">';
                                            // 文章按时间倒序
                                            node._files.sort(function(a, b){ return b.date - a.date; }).forEach(function(post){
                                                html += '<li class="note-file">';
                                                html += '<a href="' + url_for(post.path) + '" class="note-link" title="' + post.title + '">' + post.title + '</a>';
                                                html += '</li>';
                                            });
                                            html += '</ul>';
                                        }
                                        return html;
                                    }

                                    // 执行构建
                                    var myTree = buildTree(notePosts);
                                %>

                                <!-- 输出渲染结果 -->
                                <div class="note-tree-container">
                                    <%- renderTree(myTree, 0) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </aside>
            <% } %>
        </div>

        <!-- === 2. 中间主内容区 === -->
        <main class="paper-main">
            
            <!-- Header: 动态 Tabs 区域 -->
            <header class="paper-header">
                <!-- 左侧：选项卡 -->
                <div class="header-tabs">
                    <% if (pageType === 'Home') { %>
                        <button class="header-tab-btn active" onclick="switchTab('tab-posts')">Articles</button>
                        <button class="header-tab-btn" onclick="switchTab('tab-tags')">Tags</button>
                        <button class="header-tab-btn" onclick="switchTab('tab-archives')">Archives</button>
                    
                    <!-- 修改点：增加 && !is_post() 判断 -->
                    <!-- 只有在 Blog/Note 的列表页显示选项卡，在具体文章页不显示 -->
                    <% } else if ((pageType === 'Blog' || pageType === 'Note') && !is_post()) { %>
                        <button class="header-tab-btn active" onclick="switchTab('tab-posts')">Articles</button>
                        <button class="header-tab-btn" onclick="switchTab('tab-tags')">Tags</button>
                    
                    <% } else if (pageType === 'About') { %>
                        <button class="header-tab-btn active" onclick="switchTab('tab-about')">About</button>
                        <button class="header-tab-btn" onclick="switchTab('tab-friends')">Friends</button>
                        <button class="header-tab-btn" onclick="switchTab('tab-gallery')">Moments</button>
                    
                    <% } else { %>
                        <!-- 文章详情页 (is_post) 会落到这里 -->
                        <!-- 留一个空的占位符，保持 Flex 布局，确保右侧的大标题不跑偏 -->
                        <div style="height: 38px;"></div> 
                    <% } %>
                </div>

                <!-- 右侧：文字 (Mu Blog / Blog / Note / About) -->
                <div class="header-right-title">
                    <%= headerText %>
                </div>
            </header>

            <div class="paper-content">
                <%- body %>
            </div>

            <footer class="paper-footer">
                <p>&copy; <%= new Date().getFullYear() %> <%= config.author %>. Powered by <span style="color:#b7b7b7;"><a href="https://hexo.io/" target="_blank">Hexo</a></span>.</p>
                <p>本博客所有文章除特别声明外，均采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank">CC BY-NC-SA 4.0</a> 许可协议，转载请注明出处。</p>
            </footer>
        </main>

        <!-- === 3. 右侧区域 === -->
        <% if (showRightSidebar) { %>
            <aside class="right-column">
                <% if (is_post()) { %>
                    <!-- 文章详情页：显示 TOC -->
                    <div class="sidebar-card toc-card">
                        <h4 class="toc-title">Catalog</h4>
                        <%- toc(page.content, {list_number: false, max_depth: 3}) %>
                    </div>
                <% } else { %>
                    <!-- Home / About / Blog List / Note List 页面：显示日历和统计 -->
                    
                    <!-- 卡片1: 日历 -->
                    <div class="sidebar-card calendar-card">
                        <div class="calendar-widget">
                            <div class="calendar-header" id="calHeader"></div>
                            <div class="calendar-body">
                                <span class="cal-day-name">S</span><span class="cal-day-name">M</span><span class="cal-day-name">T</span>
                                <span class="cal-day-name">W</span><span class="cal-day-name">T</span><span class="cal-day-name">F</span>
                                <span class="cal-day-name">S</span>
                                <!-- JS 将填充日期 -->
                                <div id="calDays" style="display:contents"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 卡片2: 站点统计 -->
                    <div class="sidebar-card site-info-card">
                        <div class="site-info-row">
                            <span>Articles</span>
                            <span class="site-info-val"><%= site.posts.length %></span>
                        </div>
                        <div class="site-info-row">
                            <span>Tags</span>
                            <span class="site-info-val"><%= site.tags.length %></span>
                        </div>
                        <div class="site-info-row">
                            <span>Running</span>
                            <span class="site-info-val" id="runDays">0 Days</span>
                        </div>
                    </div>
                <% } %>
            </aside>
        <% } %>
    </div>

    <% if (sidebarCfg.links && sidebarCfg.links.length) { %>
        <div class="mobile-float-nav" id="mobileFloatNav" aria-hidden="true">
            <button type="button" class="mobile-nav-fab" id="mobileNavFab" aria-label="打开站点导航">Menu</button>
            <nav class="mobile-float-nav-panel" id="mobileFloatNavPanel" aria-label="移动端导航">
                <% sidebarCfg.links.forEach(function(link){ %>
                    <%
                        var mText = (link.text || '').toLowerCase();
                        var mTarget = '';
                        if (mText === 'home') mTarget = 'Home';
                        else if (mText === 'blog') mTarget = 'Blog';
                        else if (mText === 'note') mTarget = 'Note';
                        else if (mText === 'about') mTarget = 'About';
                        var mActive = mTarget && mTarget === pageType;
                    %>
                    <a href="<%= link.url %>" class="mobile-float-nav-link <%= mActive ? 'active' : '' %>"><%= link.text %></a>
                <% }) %>
            </nav>
        </div>
    <% } %>

    <!-- 脚本库 -->
    <script>
        // 1. Sidebar Toggle
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtn = document.getElementById('sidebarToggle');
            var sidebar = document.getElementById('userSidebar');
            if(toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('collapsed');
                    sidebar.classList.toggle('expanded');
                });
            }
        });

        // 2. Tab Switching Logic (Global)
        window.switchTab = function(tabId) {
            // 切换按钮状态
            const buttons = document.querySelectorAll('.header-tab-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.currentTarget.classList.add('active');

            // 切换内容显示
            const items = document.querySelectorAll('.tab-content-item');
            items.forEach(item => item.classList.remove('active'));
            
            const target = document.getElementById(tabId);
            if(target) target.classList.add('active');
        }

        // 3. Calendar & Run Days
        document.addEventListener('DOMContentLoaded', function() {
            // Calendar
            const date = new Date();
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            const calHeader = document.getElementById('calHeader');
            const calDays = document.getElementById('calDays');
            
            if(calHeader && calDays) {
                calHeader.innerText = monthNames[date.getMonth()] + " " + date.getFullYear();
                
                const firstDay = new Date(date.getFullYear(), date.getMonth(), 1).getDay();
                const daysInMonth = new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();
                
                let html = '';
                // Empty slots
                for(let i=0; i<firstDay; i++) html += '<span class="cal-day empty"></span>';
                // Days
                for(let i=1; i<=daysInMonth; i++) {
                    let className = 'cal-day';
                    if(i === date.getDate()) className += ' today';
                    html += `<span class="${className}">${i}</span>`;
                }
                calDays.innerHTML = html;
            }

            // Run Days (Change start date here)
            const startDate = new Date("2022-11-11"); // 修改你的建站日期
            const runDaysEl = document.getElementById('runDays');
            if(runDaysEl) {
                const diff = Math.floor((new Date() - startDate) / (1000 * 60 * 60 * 24));
                runDaysEl.innerText = diff + " Days";
            }
        });

        // 4. Tag Filtering Logic
        window.filterByTag = function(tagName) {
            // 切换到文章列表 Tab
            const postsTabBtn = document.querySelector('button[onclick="switchTab(\'tab-posts\')"]');
            if(postsTabBtn) postsTabBtn.click();

            // 更新 Tag Chip 激活态
            const chips = document.querySelectorAll('.filter-tag-chip');
            chips.forEach(chip => {
                const chipTag = chip.getAttribute('data-tag');
                const isActive = (tagName === 'all' && chipTag === 'all') || chipTag === tagName;
                chip.classList.toggle('is-active', isActive);
            });

            // 筛选文章
            const cards = document.querySelectorAll('.post-card');
            cards.forEach(card => {
                const tags = card.getAttribute('data-tags') || '';
                const tagList = tags ? tags.split(',').map(tag => tag.trim()) : [];
                if(tagName === 'all' || tagList.includes(tagName)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // 5. Archive Type Filtering Logic
        window.filterArchiveType = function(typeName) {
            const chips = document.querySelectorAll('.archive-filter-chip');
            chips.forEach(chip => {
                const chipType = chip.getAttribute('data-type');
                const isActive = (typeName === 'all' && chipType === 'all') || chipType === typeName;
                chip.classList.toggle('is-active', isActive);
            });

            const items = document.querySelectorAll('.timeline-item');
            items.forEach(item => {
                const itemType = item.getAttribute('data-archive-type');
                const visible = typeName === 'all' || itemType === typeName;

                if (visible) {
                    const wasHidden = item.classList.contains('hidden');
                    item.classList.remove('hidden');
                    if (wasHidden) {
                        item.classList.remove('entering');
                        void item.offsetWidth;
                        item.classList.add('entering');
                    }
                } else {
                    item.classList.add('hidden');
                    item.classList.remove('entering');
                }
            });

            const yearAnchors = document.querySelectorAll('.timeline-year-anchor');
            yearAnchors.forEach(anchor => {
                let next = anchor.nextElementSibling;
                let hasVisibleItem = false;
                while (next && !next.classList.contains('timeline-year-anchor')) {
                    if (next.classList.contains('timeline-item') && !next.classList.contains('hidden')) {
                        hasVisibleItem = true;
                        break;
                    }
                    next = next.nextElementSibling;
                }
                anchor.classList.toggle('hidden', !hasVisibleItem);
            });
        }

        // 6. Moments Lightbox
        document.addEventListener('DOMContentLoaded', function() {
            var lightbox = document.getElementById('photoLightbox');
            var lightboxImage = document.getElementById('photoLightboxImage');
            var lightboxCaption = document.getElementById('photoLightboxCaption');
            var closeBtn = document.getElementById('photoLightboxClose');

            if (!lightbox || !lightboxImage || !lightboxCaption || !closeBtn) return;

            if (lightbox.parentNode !== document.body) {
                document.body.appendChild(lightbox);
            }

            function closeLightbox() {
                lightbox.classList.remove('is-open');
                lightbox.setAttribute('aria-hidden', 'true');
                lightboxImage.setAttribute('src', '');
                lightboxCaption.textContent = '';
            }

            document.addEventListener('click', function(event) {
                var trigger = event.target.closest('.photo-zoom-trigger');
                if (trigger) {
                    var src = trigger.getAttribute('data-photo-src') || '';
                    var caption = trigger.getAttribute('data-photo-caption') || '';
                    if (!src) return;
                    lightboxImage.setAttribute('src', src);
                    lightboxCaption.textContent = caption;
                    lightbox.classList.add('is-open');
                    lightbox.setAttribute('aria-hidden', 'false');
                    return;
                }

                if (event.target.matches('[data-action="close-lightbox"]')) {
                    closeLightbox();
                }
            });

            closeBtn.addEventListener('click', closeLightbox);

            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && lightbox.classList.contains('is-open')) {
                    closeLightbox();
                }
            });
        });

        // 7. Mobile Floating Navigation
        document.addEventListener('DOMContentLoaded', function() {
            var floatNav = document.getElementById('mobileFloatNav');
            var fab = document.getElementById('mobileNavFab');
            var panel = document.getElementById('mobileFloatNavPanel');
            if (!floatNav || !fab || !panel) return;

            function isMobileViewport() {
                return window.matchMedia('(max-width: 768px)').matches;
            }

            function openPanel() {
                panel.classList.add('open');
                fab.classList.add('is-open');
            }

            function closePanel() {
                panel.classList.remove('open');
                fab.classList.remove('is-open');
            }

            function clampPosition(x, y) {
                var rect = floatNav.getBoundingClientRect();
                var maxX = window.innerWidth - rect.width - 8;
                var maxY = window.innerHeight - rect.height - 8;
                return {
                    x: Math.min(Math.max(8, x), Math.max(8, maxX)),
                    y: Math.min(Math.max(8, y), Math.max(8, maxY))
                };
            }

            function setPosition(x, y) {
                var p = clampPosition(x, y);
                floatNav.style.left = p.x + 'px';
                floatNav.style.top = p.y + 'px';
                floatNav.style.right = 'auto';
                floatNav.style.bottom = 'auto';
            }

            function resetPositionForDesktop() {
                if (!isMobileViewport()) {
                    floatNav.style.left = '';
                    floatNav.style.top = '';
                    floatNav.style.right = '';
                    floatNav.style.bottom = '';
                    closePanel();
                }
            }

            var pointerId = null;
            var dragging = false;
            var moved = false;
            var startX = 0;
            var startY = 0;
            var originX = 0;
            var originY = 0;

            fab.addEventListener('pointerdown', function(e) {
                if (!isMobileViewport()) return;
                pointerId = e.pointerId;
                dragging = true;
                moved = false;
                startX = e.clientX;
                startY = e.clientY;
                var rect = floatNav.getBoundingClientRect();
                originX = rect.left;
                originY = rect.top;
                fab.setPointerCapture(pointerId);
            });

            fab.addEventListener('pointermove', function(e) {
                if (!dragging || e.pointerId !== pointerId) return;
                var dx = e.clientX - startX;
                var dy = e.clientY - startY;
                if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
                setPosition(originX + dx, originY + dy);
            });

            fab.addEventListener('pointerup', function(e) {
                if (e.pointerId !== pointerId) return;
                if (dragging) {
                    dragging = false;
                    fab.releasePointerCapture(pointerId);
                }
            });

            fab.addEventListener('pointercancel', function(e) {
                if (e.pointerId !== pointerId) return;
                dragging = false;
            });

            fab.addEventListener('click', function(e) {
                if (!isMobileViewport()) return;
                if (moved) {
                    e.preventDefault();
                    moved = false;
                    return;
                }
                if (panel.classList.contains('open')) closePanel();
                else openPanel();
            });

            panel.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', closePanel);
            });

            document.addEventListener('click', function(e) {
                if (!isMobileViewport()) return;
                if (!floatNav.contains(e.target)) closePanel();
            });

            window.addEventListener('resize', function() {
                if (!isMobileViewport()) {
                    resetPositionForDesktop();
                    return;
                }
                var rect = floatNav.getBoundingClientRect();
                setPosition(rect.left, rect.top);
            });
        });
    </script>
    <script>
    MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true,
        tags: 'ams',
        // 显式加载 boldsymbol 包，虽然 MathJax 3 默认通常包含，但为了保险
        packages: {'[+]': ['boldsymbol']} 
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
        // 忽略 hexo-filter-mathjax 保护起来的标签
        ignoreHtmlClass: 'tex2jax_ignore'
      },
      loader: {
        load: ['[tex]/boldsymbol'] 
      }
    };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script>
    function initCalendar() {
        const date = new Date();
        const calHeader = document.getElementById('calHeader');
        const calDays = document.getElementById('calDays');
        if(!calHeader || !calDays) return;

        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        calHeader.innerText = monthNames[date.getMonth()] + " " + date.getFullYear();

        const firstDay = new Date(date.getFullYear(), date.getMonth(), 1).getDay();
        const daysInMonth = new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();

        let html = '';
        // 填充空白
        for(let i=0; i<firstDay; i++) html += '<span class="cal-day empty"></span>';
        // 填充日期
        for(let i=1; i<=daysInMonth; i++) {
            let isToday = (i === date.getDate()) ? 'today' : '';
            html += `<span class="cal-day ${isToday}">${i}</span>`;
        }
        calDays.innerHTML = html;
    }
    document.addEventListener('DOMContentLoaded', initCalendar);
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const highlights = document.querySelectorAll('figure.highlight');
        
        highlights.forEach(block => {
            // 创建复制按钮
            const button = document.createElement('button');
            button.className = 'copy-btn';
            button.type = 'button';
            button.innerText = 'Copy';
            
            block.appendChild(button);

            button.addEventListener('click', () => {
                // 兼容性获取代码文本：优先寻找 pre，否则找 td.code
                const codeElement = block.querySelector('.code pre') || block.querySelector('td.code');
                const code = codeElement.innerText;
                
                navigator.clipboard.writeText(code).then(() => {
                    button.innerText = 'Copied!';
                    button.classList.add('success');
                    
                    setTimeout(() => {
                        button.innerText = 'Copy';
                        button.classList.remove('success');
                    }, 2000);
                }).catch(err => {
                    console.error('Copy failed:', err);
                });
            });
        });
    });
    </script>
</body>
</html>
